// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserType {
  artist
  admin
  superAdmin
  curator
  general
}

model User {
  id                 String   @id @default(uuid())
  name               String
  lastName           String
  userType           UserType @default(general)
  handler            String   @unique
  biography          String
  email              String?  @unique
  password           String?
  mustChangePassword Boolean  @default(false)
  profileImageUrl    String?
  // Transparent-PNG signature used on certificates of authenticity for
  // printed works by this artist. Nullable — certificates fall back to
  // the printed artist name when this is not yet set.
  signatureUrl       String?
  isFeatured         Boolean  @default(false)
  published          Boolean  @default(false)

  // Two-Factor Authentication
  totpSecret       String?
  twoFactorEnabled Boolean @default(false)

  // Magic Link Authentication
  magicLinkToken  String?
  magicLinkExpiry DateTime?

  // Email 2FA Login Code
  loginCode       String?
  loginCodeExpiry DateTime?

  // Stripe Connect (Express) — the artist's connected Stripe account.
  // `onboardingComplete` flips true once `account.updated` arrives with
  // charges_enabled + payouts_enabled. We never trust the client-side
  // return from the onboarding redirect on its own.
  stripeAccountId          String?
  stripeOnboardingComplete Boolean @default(false)

  exhibitions     Exhibition[]
  artworks        Artwork[]
  presets         ArtworkPreset[]
  accounts        Account[]
  sessions        Session[]
  printOrders     PrintOrder[]
  printOrderItems PrintOrderItem[]
}

model ArtworkPreset {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name       String
  presetType String @default("image") // "image" or "text"

  // Dimensions
  width2d  Float @default(100)
  height2d Float @default(100)

  // Frame
  showFrame               Boolean @default(false)
  frameColor              String  @default("#000000")
  frameSize               Float   @default(5)
  frameThickness          Float   @default(2)
  frameMaterial           String  @default("plastic")
  frameCornerStyle        String  @default("mitered")
  frameTextureScale       Float   @default(2.0)
  frameTextureRotation    Float   @default(0)
  frameTextureRoughness   Float   @default(0.6)
  frameTextureNormalScale Float   @default(0.5)

  // Passepartout
  showPassepartout      Boolean @default(false)
  passepartoutColor     String  @default("#ffffff")
  passepartoutSize      Float   @default(10)
  passepartoutThickness Float   @default(0.6)

  // Border (white paper margin around image)
  showPaperBorder Boolean @default(false)
  paperBorderSize Float   @default(0)

  // Support
  showSupport      Boolean @default(false)
  supportThickness Float   @default(2.0)
  supportColor     String  @default("#ffffff")

  // Shadow
  hideShadow Boolean @default(false)

  // Text styling (used when presetType = "text")
  fontFamily            String  @default("Montserrat")
  fontSize              Float   @default(16)
  fontWeight            String  @default("400")
  letterSpacing         Float   @default(0)
  lineHeight            Float   @default(1.4)
  textColor             String  @default("#000000")
  textBackgroundColor   String?
  textAlign             String  @default("left")
  textVerticalAlign     String  @default("top")
  textPadding           Float   @default(0)
  textPaddingTop        Float   @default(0)
  textPaddingBottom     Float   @default(0)
  textPaddingLeft       Float   @default(0)
  textPaddingRight      Float   @default(0)
  textThickness         Float   @default(0) // Card depth in cm (0-5), only when background color is set
  textBackgroundTexture String? // e.g. 'paper', 'cardboard'
  showTextBorder        Boolean @default(false)
  textBorderColor       String  @default("#c9a96e") // Decorative inset border color
  textBorderOffset      Float   @default(1.2) // Inset distance in cm
  showMonogram          Boolean @default(false)
  monogramColor         String  @default("#c0392b")
  monogramOpacity       Float   @default(1.0)
  monogramPosition      String  @default("bottom") // 'top' or 'bottom'
  monogramOffset        Float   @default(6)
  monogramSize          Float   @default(18) // Distance from edge as % of card height

  // Shape decoration properties
  shapeType    String @default("rectangle")
  shapeColor   String @default("#000000")
  shapeOpacity Float  @default(1.0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Artwork {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name                 String
  slug                 String  @unique
  artworkType          String  @default("image")
  title                String  @default("Untitled")
  author               String?
  year                 String?
  technique            String?
  dimensions           String?
  description          String?
  imageUrl             String? // Web-optimized image (CDN)
  originalImageUrl     String? // High-res original for print fulfillment (no CDN)
  originalWidth        Int? // Original image width in pixels
  originalHeight       Int? // Original image height in pixels
  originalDpi          Int? // Image DPI from EXIF metadata
  originalFormat       String? // Original file format (JPEG, PNG, etc.)
  originalSizeBytes    Int? // Original file size in bytes
  textContent          String? // Fixed text content for stencil/text artworks
  soundUrl             String? // Audio file URL for sound artworks
  videoUrl             String? // Video file URL for video artworks
  featured             Boolean @default(false)
  hiddenFromExhibition Boolean @default(false)
  order                Int     @default(0)

  // Print sales (theprintspace fulfillment). `printEnabled` gates the
  // "Order Print" CTA + the /print wizard; when false the artwork page
  // shows "Inquire" instead. `printPriceCents` is the artist's cut
  // per print (the gallery markup + TPS cost stack on top at
  // checkout time). Nullable so we can distinguish "not set yet"
  // from a deliberate zero.
  printEnabled    Boolean @default(false)
  printPriceCents Int?

  // Edition model. `editionType` is the canonical, mutually-exclusive
  // switch between the two TPS fulfillment paths:
  //   'open'    → TPS "Order Prints": the full configurable wizard
  //               (any size, all framing, full paper set).
  //   'limited' → TPS "Sell as Print" / Manual Dropship: print-only,
  //               numbered, pre-defined `limitedVariants`.
  // One-way door: 'open' → 'limited' is allowed once, but never back.
  // `editionLocked` flips true the moment a variant is published (and
  // edition numbers are materialised); from then the type and the
  // published variants' size/editionSize are frozen.
  editionType   String  @default("open")
  editionLocked Boolean @default(false)

  // Legacy limited-edition flags, superseded by `editionType` +
  // `limitedVariants`. Kept for back-compat; no longer written by new
  // code. Existing flag-limited artworks stay on the open path until
  // re-saved with variants.
  printEditionLimited Boolean @default(false)
  printEditionTotal   Int?

  // Per-artwork printing restrictions set by the artist. Canonical
  // PrintRestrictions shape: { allowed: { dimensionId: ids[] } }.
  // When null / missing / field missing, all options from the catalog
  // are offered. Each dimension is validated server-side at
  // PaymentIntent creation.
  printOptions Json?

  // Soft "recommended by the artist" markers — distinct from the
  // hard restriction list above. Shape: { paper: string[] } (paper
  // IDs only for now). Surfaces a check-circle in the buyer's paper
  // picker; does NOT filter availability. An artist can't recommend
  // a paper they've also hard-restricted (validated at write time).
  printRecommendations Json?

  exhibitionArtworks ExhibitionArtwork[]
  printOrders        PrintOrder[]
  printOrderItems    PrintOrderItem[]
  limitedVariants    LimitedVariant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One pre-defined offering of a LIMITED-edition artwork. A limited
// artwork has 1 mandatory + up to 3 optional variants (max 4). Each
// variant is its OWN independent edition with its own numbering
// sequence (e.g. "Small" 1/50, "Medium" 1/40). The buyer simply picks
// a variant — no per-print configuration. Limited variants are always
// print-only (never framed); the edition number prints bottom-left in
// the border margin. Sizes must be DISTINCT within an artwork because
// TPS keys edition identity on the unframed print size.
model LimitedVariant {
  id        String  @id @default(uuid())
  artworkId String
  artwork   Artwork @relation(fields: [artworkId], references: [id], onDelete: Cascade)

  name        String // free title, e.g. "Small"
  paperId     String // TPS paper id (validated against TPS_PAPERS)
  printTypeId String // 'giclee' | 'ctype', derived from the paper
  widthCm     Float // locked to the artwork's aspect ratio
  heightCm    Float
  borderCm    Float  @default(0) // uniform paper border (holds the number)
  editionSize Int // this variant's own edition size, e.g. 50
  priceCents  Int? // artist's cut for THIS variant, in cents (size-based pricing)

  // A variant is published once its edition numbers are materialised.
  // Publishing locks the parent artwork (`editionLocked`) and freezes
  // this variant's size/editionSize. `order` keeps the mandatory
  // variant first (0) and orders the optional ones.
  published Boolean @default(false)
  // Per-variant lock. Meaningful only once `published`: a published variant
  // is `blocked` (frozen + on sale) until an admin unblocks it to fix a
  // mistake. While unblocked (`blocked: false`) its fields are editable AND
  // it's paused from sale (buyers only see `published && blocked`). Admins
  // re-Block it when done. Sold/reserved edition numbers are never affected.
  blocked   Boolean @default(true)
  order     Int     @default(0)

  editionNumbers EditionNumber[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Distinct print size per artwork (TPS edition-identity rule).
  @@unique([artworkId, widthCm, heightCm])
  @@index([artworkId])
}

// One row per individual numbered print in a variant's edition (1..N).
// This table is our AUTHORITATIVE edition ledger — TPS is mirrored by
// hand from it, never the reverse. Rows are pre-materialised when the
// variant is published so the `@@unique([variantId, number])` constraint
// is the atomic oversell gate. State machine:
//   available → reserved (at Stripe PI create)
//   reserved  → reserved+orderId bound (at auth / order creation)
//   reserved  → sold (at capture / admin markPlaced)
//   reserved/sold → available (released on cancel / fail / expiry / reject)
model EditionNumber {
  id        String         @id @default(uuid())
  variantId String
  variant   LimitedVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  number Int // 1..editionSize; printed as "number/editionSize"

  // 'available' | 'reserved' | 'sold'
  state String @default("available")

  // The Stripe PI that currently holds this number while reserved/sold;
  // cleared on release. Bound to a PrintOrderItem at auth (cart flow).
  paymentIntentId String?
  orderItemId     String?         @unique
  orderItem       PrintOrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  // DEPRECATED (AR-129) — single-print one-to-one link to PrintOrder. Cart
  // flow uses orderItemId. Kept additively until the AR-129 cleanup task.
  orderId String?     @unique
  order   PrintOrder? @relation("PrintOrderEditionNumber", fields: [orderId], references: [id], onDelete: SetNull)

  buyerEmail String? // denormalised snapshot for the ledger view
  reservedAt DateTime?
  soldAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Hard oversell gate: one row per (variant, number); never reused.
  @@unique([variantId, number])
  // "Next available number" query + reservation lookups.
  @@index([variantId, state])
  @@index([paymentIntentId])
}

model PrintOrder {
  id              String @id @default(uuid())
  paymentIntentId String @unique

  artworkId    String
  artwork      Artwork @relation(fields: [artworkId], references: [id], onDelete: Restrict)
  artistUserId String
  artistUser   User    @relation(fields: [artistUserId], references: [id], onDelete: Restrict)

  buyerEmail      String
  buyerName       String
  shippingAddress Json // ShippingAddress snapshot at checkout time
  printConfig     Json // PrintConfig snapshot at checkout time
  country         String

  // All amounts in minor units (cents) for the given currency. NOTE
  // (AR-129): for the multi-item cart flow these per-order item amounts
  // become rollups and the authoritative per-item money lives on
  // PrintOrderItem; the columns are made nullable in the Task 9 cart
  // order-creation work (kept required here so the single-print path is
  // untouched in this additive schema step).
  totalCents              Int
  artistCents             Int
  galleryCents            Int
  productionCents         Int
  productionShippingCents Int
  customerVatCents        Int
  currency                String @default("eur")

  // 'processing' | 'succeeded' | 'failed' | 'refunded'
  paymentStatus String @default("processing")

  // Manual TPS fulfillment stage. Admin advances by hand from
  // /admin/orders after placing the order on theprintspace's portal.
  // Values: null (pending placement) | 'Placed' | 'Started' | 'Shipped'
  // | 'Complete' | 'Rejected'.
  fulfillmentStatus String?
  trackingUrl       String?
  shippedAt         DateTime?

  // DEPRECATED — no longer read/written by AR-126 code. Kept ONLY so the
  // schema stays additive against prod, where `main` still reads/writes it.
  // Drop this column (schema + DB) in a follow-up once AR-126 is live on prod.
  certificateUrl String?

  // Single-print-era per-order payout. AR-129 cart flow uses per-item
  // payouts (PrintOrderItem.{transferId,transferStatus,paidOutAt}); these
  // stay for the single-print path during migration.
  transferId     String?
  transferStatus String?
  paidOutAt      DateTime?

  // Limited-edition fulfillment: timestamp set when the admin has
  // manually mirrored this order's edition number(s) as "sold" in TPS's
  // Manage Edition modal. Our `EditionNumber` ledger is authoritative;
  // this just records that the by-hand TPS step is done. Null for open
  // editions and for limited orders not yet mirrored.
  tpsEditionMirroredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // DEPRECATED (AR-129) — single-print one-to-one edition link. Cart flow
  // links EditionNumber.orderItemId → PrintOrderItem instead.
  editionNumber EditionNumber? @relation("PrintOrderEditionNumber")

  items  PrintOrderItem[]
  events PrintOrderEvent[]

  @@index([artistUserId])
  @@index([paymentStatus, fulfillmentStatus, transferStatus])
}

model PrintOrderItem {
  id      String     @id @default(uuid())
  orderId String
  order   PrintOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  artworkId    String
  artwork      Artwork @relation(fields: [artworkId], references: [id], onDelete: Restrict)
  artistUserId String
  artistUser   User    @relation(fields: [artistUserId], references: [id], onDelete: Restrict)

  printConfig Json // WizardConfig snapshot for this item
  quantity    Int  @default(1)

  // Line totals in cents (unit × quantity).
  productionCents Int
  artistCents     Int
  galleryCents    Int

  // Per-item Stripe Connect payout. Mixed-artist orders pay each artist
  // independently, so an order can be partly paid out.
  // 'pending' | 'paid' | 'reversed'
  transferId     String?
  transferStatus String?
  paidOutAt      DateTime?

  certificateUrl String? // one COA per item

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  editionNumbers EditionNumber[]

  @@index([orderId])
  @@index([artistUserId])
  @@index([transferStatus])
}

// Append-only audit trail for everything that happens to a PrintOrder.
// Every webhook, every API call we make, every admin action emits a row.
// Used for debugging, incident review, and rendering the order timeline
// in the admin UI. Never update or delete rows in this table.
model PrintOrderEvent {
  id      String     @id @default(uuid())
  orderId String
  order   PrintOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  at      DateTime   @default(now())

  // e.g. 'auth_received', 'captured', 'capture_failed', 'shipped',
  // 'email_sent', 'admin_action'.
  kind String

  // 'stripe' | 'system' | 'admin:<userId>'
  actor String

  // Raw webhook/API payload. JSON so we can store whatever the source gave us.
  payload Json?

  // Short human-readable summary for the timeline view.
  message String?

  @@index([orderId, at])
  @@index([kind, at])
}

model Exhibition {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  handler           String
  mainTitle         String
  description       String?
  shortDescription  String?
  url               String    @unique
  thumbnailUrl      String?
  bannerUrl         String?
  featuredImageUrl  String?
  spaceId           String
  startDate         DateTime?
  endDate           DateTime?
  status            String
  published         Boolean   @default(false)
  publishedAt       DateTime? // When last published/updated
  publishedSnapshot Json? // Full snapshot at publish time
  hasPendingChanges Boolean   @default(false) // True when draft differs from published
  previewEnabled    Boolean   @default(false) // When true, visit route is accessible even if unpublished
  previewToken      String? // UUID token required in ?preview= param

  // Lighting customization (space-agnostic)
  ambientLightColor      String?  @default("#e4e8f2")
  ambientLightIntensity  Float?   @default(1.0)
  skylightColor          String?  @default("#ffffff")
  skylightIntensity      Float?   @default(4.0)
  ceilingLampColor       String?  @default("#ffffff")
  ceilingLampIntensity   Float?   @default(4.0)
  trackLampColor         String?  @default("#ffffff")
  trackLampIntensity     Float?   @default(4.0)
  trackLampsVisible      Boolean? @default(true)
  recessedLampColor      String?  @default("#ffffff")
  recessedLampIntensity  Float?   @default(4.0)
  recessedLampAngle      Float?   @default(0.45)
  recessedLampDistance   Float?   @default(15.0)
  trackLampMaterialColor String?  @default("#ffffff")
  trackLampAngle         Float?   @default(0.45)
  trackLampDistance      Float?   @default(5.0)
  trackLampSettings      Json?
  windowLightColor       String?  @default("#ffffff")
  windowLightIntensity   Float?   @default(4.0)
  windowTransparency     Boolean? @default(false)
  hdriRotation           Float?   @default(128)
  floorReflectiveness    Float?   @default(0.3)
  floorMaterial          String?  @default("concrete")
  floorTextureScale      Float?   @default(1.0)
  floorTextureOffsetX    Float?   @default(0)
  floorTextureOffsetY    Float?   @default(0)
  floorTemperature       Float?   @default(0)
  floorNormalScale       Float?   @default(1.0)
  floorRotation          Float?   @default(0)
  // HDRI environment
  hdriEnvironment        String?  @default("soil")
  ceilingLightMode       String?  @default("track-plafond")
  // Camera settings
  cameraFOV              Float?   @default(50)
  cameraElevation        Float?   @default(1.6)

  // Wall & Ceiling customization
  wallColor      String? @default("#ffffff")
  ceilingColor   String? @default("#ffffff")
  wallBrightness Float?  @default(1.8)

  // Shadow decal controls
  shadowBlur      Float? @default(0.025)
  shadowSpread    Float? @default(1.2)
  shadowOpacity   Float? @default(0.25)
  shadowDirection Float? @default(0.2)

  // Autofocus groups (JSON array of { id, name, artworkIds })
  autofocusGroups Json?

  exhibitionArtworks ExhibitionArtwork[]
  wallGuides         WallGuide[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ExhibitionArtwork {
  id           String     @id @default(uuid())
  exhibitionId String
  exhibition   Exhibition @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  artworkId    String
  artwork      Artwork    @relation(fields: [artworkId], references: [id], onDelete: Cascade)

  wallId      String
  posX2d      Float
  posY2d      Float
  width2d     Float
  height2d    Float
  posX3d      Float
  posY3d      Float
  posZ3d      Float
  quaternionX Float
  quaternionY Float
  quaternionZ Float
  quaternionW Float

  // Display properties (per-exhibition customization)
  showFrame               Boolean @default(false)
  frameColor              String  @default("#000000")
  frameSize               Float   @default(5) // Border width (XY)
  frameThickness          Float   @default(2) // Z-depth
  frameMaterial           String  @default("plastic")
  frameCornerStyle        String  @default("mitered")
  frameTextureScale       Float   @default(2.0)
  frameTextureRotation    Float   @default(0)
  frameTextureRoughness   Float   @default(0.6)
  frameTextureNormalScale Float   @default(0.5)
  showPassepartout        Boolean @default(false)
  passepartoutColor       String  @default("#ffffff")
  passepartoutSize        Float   @default(10) // Border width around artwork (XY)
  passepartoutThickness   Float   @default(0.6) // Z-depth of passepartout in 3D
  showPaperBorder         Boolean @default(false)
  paperBorderSize         Float   @default(0) // White paper margin around image, equal on all sides (cm)
  showArtworkInformation  Boolean @default(false)

  // Support (canvas/panel depth) - rendering depth behind artwork
  showSupport      Boolean @default(false) // Whether support is visible
  supportThickness Float   @default(2.0) // Depth in cm (0-10)
  supportColor     String  @default("#ffffff") // Edge color

  // Shadow
  hideShadow Boolean @default(false) // Whether to hide artwork shadow

  // Text styling (per-exhibition customization)
  fontFamily            String  @default("Montserrat")
  fontSize              Float   @default(16)
  fontWeight            String  @default("400")
  letterSpacing         Float   @default(0)
  lineHeight            Float   @default(1.4)
  textColor             String  @default("#000000")
  textBackgroundColor   String?
  textAlign             String  @default("left")
  textVerticalAlign     String  @default("top")
  textPadding           Float   @default(0) // Padding in pixels
  textPaddingTop        Float   @default(0)
  textPaddingBottom     Float   @default(0)
  textPaddingLeft       Float   @default(0)
  textPaddingRight      Float   @default(0)
  textThickness         Float   @default(0) // Card depth in cm (0-5), only when background color is set
  textBackgroundTexture String? // e.g. 'paper', 'cardboard'
  showTextBorder        Boolean @default(false)
  textBorderColor       String  @default("#c9a96e")
  textBorderOffset      Float   @default(1.2)
  showMonogram          Boolean @default(false)
  monogramColor         String  @default("#c0392b")
  monogramOpacity       Float   @default(1.0)
  monogramPosition      String  @default("bottom")
  monogramOffset        Float   @default(6)
  monogramSize          Float   @default(18)

  // Sound styling (per-exhibition customization)
  soundIcon            String  @default("volume-2")
  soundBackgroundColor String?
  soundIconColor       String  @default("#000000")
  soundIconSize        Int     @default(24)
  soundPlayMode        String  @default("play-once")
  soundSpatial         Boolean @default(true)
  soundDistance        Float   @default(5)

  // Shape decoration properties (only used when artwork.artworkType = 'shape')
  shapeType    String @default("rectangle") // rectangle | circle
  shapeColor   String @default("#000000")
  shapeOpacity Float  @default(1.0)

  // Video playback (per-exhibition)
  videoPlayMode          String  @default("proximity") // 'proximity' | 'always' | 'click'
  videoLoop              Boolean @default(true) // Whether video loops
  videoVolume            Float   @default(1.0) // Volume level 0-1
  videoProximityDistance Float   @default(3) // Distance in meters to trigger play

  // Wall-normal rotation (degrees, 0-360, only used for shapes)
  rotation Float @default(0)

  // Lock protection (prevents move, resize, delete, preset, and grouping in wall view)
  locked Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([exhibitionId, artworkId])
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Slide {
  id            String   @id @default(uuid())
  order         Int      @default(0)
  imageUrl      String
  title         String
  subtitle      String
  meta          String // e.g. "7 NOV 2025 - 17 JAN 2026    NEW YORK"
  exhibitionUrl String
  isActive      Boolean  @default(true)
  // Hex color for the overlaid title/subtitle/meta text. Lets the
  // admin pick a contrasting color per slide so light or busy images
  // don't lose the text. Defaults to #ffffff (the previous behavior).
  textColor     String   @default("#ffffff")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PageContent {
  id             String   @id @default(uuid())
  slug           String   @unique // "about", "terms", "privacy", "accessibility", "prints"
  title          String
  content        String // HTML from TipTap
  // Top banner image. Currently only used by the "prints" page; other
  // pages leave it null. Stored as an R2 public URL.
  bannerImageUrl String?
  updatedAt      DateTime @updatedAt
}

model WallGuide {
  id           String     @id @default(uuid())
  exhibitionId String
  exhibition   Exhibition @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  wallId       String
  orientation  String // "horizontal" | "vertical"
  position     Float // position in metres from wall origin

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([exhibitionId, wallId])
}
